FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab

ENV LANG C.UTF-8
ENV TZ Asia/Tokyo

ENV AIR_VERSION 1.40.1

WORKDIR /go/src/github.com/and-period/furumaru/api

RUN apk add --update \
      git \
      make

RUN go install github.com/cosmtrek/air@v${AIR_VERSION}
